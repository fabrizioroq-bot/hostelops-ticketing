# Copy this file to backend/.env and fill in real values.
# Never commit the actual .env file.

ENVIRONMENT=development

# --- Supabase ---
# Project Settings > API in the Supabase dashboard.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-public-key
# Service role key bypasses Row Level Security — treat as a root credential.
# Only the backend should ever hold this; never ship it to the frontend.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Project Settings > API > JWT Settings > JWT Secret.
SUPABASE_JWT_SECRET=your-jwt-secret

# --- CORS ---
# Comma-separated list of origins allowed to call this API.
CORS_ORIGINS=http://localhost:5173

# --- Session / security ---
SESSION_TIMEOUT_MINUTES=30

# --- Mews Connector API (PMS integration) ---
# Shared across all properties for this integration. Per-property AccessTokens
# are stored separately via POST /pms/{hostel_id}/credentials, never here.
MEWS_CLIENT_TOKEN=your-mews-client-token
MEWS_BASE_URL=https://api.mews.com/api/connector/v1

# --- Resend (weekly PDF report emails) ---
RESEND_API_KEY=your-resend-api-key
RESEND_FROM_EMAIL=reports@yourdomain.com
# Optional fallback recipients in addition to all active admins/supervisors.
REPORT_RECIPIENT_EMAILS=
